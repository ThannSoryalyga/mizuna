# Local WordPress + MariaDB settings. Change these before any shared deployment.
WORDPRESS_PORT=8080
WORDPRESS_DB_NAME=mizuna
WORDPRESS_DB_USER=mizuna
WORDPRESS_DB_PASSWORD=local-dev-only-change-me
MARIADB_ROOT_PASSWORD=local-root-only-change-me

# Create React App reads REACT_APP_* variables at startup/build time.
REACT_APP_WORDPRESS_API_URL=http://localhost:8080/wp-json/wp/v2
